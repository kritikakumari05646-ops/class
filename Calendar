#CALENDAR
import calendar 

year = int(input("Enter year: "))
month = int(input("Enter month: "))

cal = calendar.monthcalendar(year, month)

print("MO TU WE TH FR SA SU")
for week in cal:
    for day in week:
        if day == 0:
            print(" ",end=" ")
        else:
            print(f"{day:2}", end=" ")
    print()
